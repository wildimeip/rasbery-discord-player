# Copy to .env and fill in. The bot token goes in secrets/discord_token, not here.
GITHUB_OWNER=wildimeip
IMAGE_TAG=stable
TZ=Europe/Prague

# Where the bot listens. Either channel ids (right-click a channel -> Copy Channel ID, with
# Developer Mode on), comma separated, or leave empty to use every channel with this name.
DISCORD_CHANNEL_IDS=
DISCORD_CHANNEL_NAME=music

# true: any message in the channel is a song request. false: only "!play <song>".
QUEUE_PLAIN_MESSAGES=true
COMMAND_PREFIX=!
# Random mode: when the queue runs out, keep playing random songs (until !stop).
# Turn it on/off from Discord with !random on|off; this is the value after a restart.
RANDOM_MODE=true
# Share (0-100) of random songs that are "like" songs people asked for (YouTube Music radio);
# the rest come straight from the song history. 0 = history only.
RANDOM_SIMILAR=70
# A song name with several matches: offer up to this many to pick from (1 = always take the
# best match), with number buttons and "None of these" (3 more matches); nothing picked
# within CHOICE_TIMEOUT seconds -> number 1.
SEARCH_CHOICES=5
CHOICE_TIMEOUT=60
# Post "Now playing ..." in the channel when a song starts.
ANNOUNCE_NOW_PLAYING=true

# Sound output, as an mpv --audio-device value. Empty = system default.
#   Headphone jack:  alsa/plughw:CARD=Headphones,DEV=0
#   HDMI:            alsa/hdmi:CARD=vc4hdmi,DEV=0
#   USB sound card:  alsa/plughw:CARD=Device,DEV=0   (name from: aplay -l)
MPV_AUDIO_DEVICE=alsa/plughw:CARD=Headphones,DEV=0
# Start volume 0-130 (change it later with !volume).
VOLUME=70
# Group id of "audio" on the Pi (getent group audio).
AUDIO_GID=29

MAX_QUEUE=200
# Longer songs are refused (0 = no limit).
MAX_SONG_MINUTES=15
# On first start, read this many old messages of the channel to fill the random pool (0 = off).
HISTORY_SCAN_LIMIT=500
# Optional YouTube Music playlist id (the "list=" part of a playlist link) that random mode
# also picks from.
RANDOM_PLAYLIST_ID=

LOG_LEVEL=INFO
